    {
      "InstanceName": "MeasCoupling",
      "Symbol": "Meas",
      "X": -1400,
      "Y": 1200,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "S21_dB",
          "Expression": "dB(SP1.S(2,1))      ; coupling between the two windings",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "S21_deg",
          "Expression": "phase(SP1.S(2,1))   ; phase() is in DEGREES",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "S11_dB",
          "Expression": "dB(SP1.S(1,1))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Zden",
          "Expression": "(1-SP1.S(1,1))*(1-SP1.S(2,2)) - SP1.S(1,2)*SP1.S(2,1)   ; S-\u003EZ denominator",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "wL1",
          "Expression": "50*imag(((1\u002BSP1.S(1,1))*(1-SP1.S(2,2)) \u002B SP1.S(1,2)*SP1.S(2,1))/Zden)   ; Im(Z11) = 2*pi*f*L1, ohms",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "wL2",
          "Expression": "50*imag(((1-SP1.S(1,1))*(1\u002BSP1.S(2,2)) \u002B SP1.S(1,2)*SP1.S(2,1))/Zden)   ; Im(Z22) = 2*pi*f*L2, ohms",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "wM",
          "Expression": "50*imag(2*SP1.S(2,1)/Zden)   ; Im(Z21) = 2*pi*f*M, ohms",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "k",
          "Expression": "wM/sqrt(wL1*wL2)   ; M/sqrt(L1*L2) - flat at 0.5, and 2*pi*f cancels",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    }
  ],
