    {
      "InstanceName": "MeasGain",
      "Symbol": "Meas",
      "X": -2100,
      "Y": 1400,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "S11_dB",
          "Expression": "dB(SP1.S(1,1))            ; i and j are 1-based PORT NUMBERS, not indices",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "S21_dB",
          "Expression": "dB(SP1.S(2,1))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "S12_dB",
          "Expression": "dB(SP1.S(1,2))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "S22_dB",
          "Expression": "dB(SP1.S(2,2))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "VSWR_in",
          "Expression": "(1\u002Bmag(SP1.S(1,1)))/(1-mag(SP1.S(1,1)))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
      "InstanceName": "MeasStability",
      "Symbol": "Meas",
      "X": -2100,
      "Y": 700,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "Delta",
          "Expression": "SP1.S(1,1)*SP1.S(2,2) - SP1.S(1,2)*SP1.S(2,1)   ; determinant",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "K",
          "Expression": "(1 - mag(SP1.S(1,1))*mag(SP1.S(1,1)) - mag(SP1.S(2,2))*mag(SP1.S(2,2)) \u002B mag(Delta)*mag(Delta)) / (2*mag(SP1.S(1,2)*SP1.S(2,1)))   ; Rollett K. x*x, not x^2: only \u002B - * / broadcast over a cube",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "MU",
          "Expression": "(1 - mag(SP1.S(1,1))*mag(SP1.S(1,1))) / (mag(SP1.S(2,2) - Delta*conj(SP1.S(1,1))) \u002B mag(SP1.S(1,2)*SP1.S(2,1)))   ; mu \u003E 1 is unconditionally stable",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "MSG_dB",
          "Expression": "dB10(mag(SP1.S(2,1))/mag(SP1.S(1,2)))            ; maximum stable gain",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    }
  ],
